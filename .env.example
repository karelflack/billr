# =============================================================================
# Billr — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values before running locally.
# NEVER commit .env to source control.
#
# Production values should be stored in your secrets manager
# (e.g. Railway's secret variables, AWS Secrets Manager, Doppler).
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# Full Postgres connection string.
# Local default matches the docker-compose postgres service credentials.
# In production, use a connection pooler URL (e.g. Supabase pgBouncer).
DATABASE_URL=postgresql://billr:billr_dev@localhost:5432/billr

# -----------------------------------------------------------------------------
# Redis / BullMQ
# -----------------------------------------------------------------------------

# Redis connection URL used by both the API (rate limiting, session cache)
# and the worker (BullMQ queue). In production use Upstash Redis TLS URL.
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------

# Secret key — used server-side only. Never expose to the browser.
# Test keys start with sk_test_; live keys start with sk_live_.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Webhook signing secret from the Stripe Dashboard → Webhooks → your endpoint.
# Used to verify that incoming Stripe webhook payloads are genuine.
# Starts with whsec_
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Publishable key — safe to embed in frontend code.
# Test keys start with pk_test_; live keys start with pk_live_.
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# -----------------------------------------------------------------------------
# Webhook signing secret encryption
# -----------------------------------------------------------------------------

# 32-byte (256-bit) key used to AES-256-GCM–encrypt webhook signing secrets
# at rest in the database.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS

# -----------------------------------------------------------------------------
# Auth / JWT
# -----------------------------------------------------------------------------

# Secret used to sign session JWTs for the dashboard.
# Generate with: openssl rand -hex 48
JWT_SECRET=REPLACE_WITH_96_HEX_CHARS

# How long dashboard session JWTs remain valid (e.g. "7d", "24h").
JWT_EXPIRY=7d

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# "development" | "test" | "production"
NODE_ENV=development

# URL of the React frontend. Used for CORS allow-list and redirect URLs.
FRONTEND_URL=http://localhost:5173

# API base URL. Used by the frontend and for generating self-referential links.
API_URL=http://localhost:3000

# Port the API server listens on inside the container (and locally).
PORT=3000

# -----------------------------------------------------------------------------
# Worker
# -----------------------------------------------------------------------------

# Number of concurrent BullMQ jobs the worker processes at once.
# Increase for higher webhook throughput; keep below DB connection pool size.
WORKER_CONCURRENCY=10

# -----------------------------------------------------------------------------
# Email (Transactional)
# -----------------------------------------------------------------------------

# SMTP credentials for sending invoice emails, trial-ending alerts, and
# GDPR export emails. Postmark / Resend / SES all work here.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=REPLACE_ME
SMTP_PASS=REPLACE_ME
EMAIL_FROM=billing@billr.io

# -----------------------------------------------------------------------------
# Storage (Invoice PDFs)
# -----------------------------------------------------------------------------

# S3-compatible bucket for generated invoice PDFs.
# Compatible with AWS S3, Supabase Storage, Cloudflare R2.
S3_BUCKET=billr-invoices
S3_REGION=eu-west-1
S3_ACCESS_KEY_ID=REPLACE_ME
S3_SECRET_ACCESS_KEY=REPLACE_ME
# Leave empty to use the default AWS endpoint; set for R2/Supabase custom endpoints.
S3_ENDPOINT=

# How long (seconds) signed PDF download URLs remain valid.
S3_SIGNED_URL_EXPIRY=3600

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------

# Global rate limit window in milliseconds.
RATE_LIMIT_WINDOW_MS=60000
# Max requests per window per API key.
RATE_LIMIT_MAX=300
# Stricter limit for auth endpoints (POST /auth/keys) to prevent key enumeration.
RATE_LIMIT_AUTH_MAX=10
